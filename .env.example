# Copy to .env and fill in what you use. .env is gitignored; never commit it.
# The offline demo (python demo.py) needs none of this.

# --- Model backend ----------------------------------------------------------
# With a key, --backend auto uses the Anthropic API. Leave it empty to use the
# local `claude -p` CLI instead (a logged-in Claude subscription, no key).
ANTHROPIC_API_KEY=
ICEBREAKERS_MODEL=claude-opus-5-5
ICEBREAKERS_EFFORT=medium

# --- Optional Google Drive hand-off (python icebreakers.py drive ...) -------
# OAuth desktop client + a refresh token with Drive and Sheets scopes.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Refuse to run when the token belongs to any other Google account.
GOOGLE_EXPECTED_ACCOUNT=you@example.com
# Folder 1 = lists waiting for icebreakers, folder 2 = enriched Sheets (n8n watches it).
DRIVE_FOLDER_TO_ENRICH=your-folder-1-id
DRIVE_FOLDER_ENRICHED=your-folder-2-id
# Time zone for the date in the enriched Sheet's title.
ICEBREAKERS_TZ=UTC
